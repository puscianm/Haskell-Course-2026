cabal-version:       2.2

name:                ProbLang
version:             0.1.0.0
homepage:            https://github.com/githubuser/ProbLang#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Author name here
maintainer:          example@example.com
copyright:           2026 Author name here
category:            Language
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

common warnings
  ghc-options:  -Wall
                -Wcompat
                -Widentities
                -Wincomplete-record-updates
                -Wincomplete-uni-patterns
                -Wmissing-export-lists
                -Wmissing-home-modules
                -Wpartial-fields
                -Wredundant-constraints

library
  import:              warnings
  hs-source-dirs:      src
  exposed-modules:     AST
                     , Distributions
                     , Inference
                     , Interpreter
                     , Parser
  default-language:    Haskell2010
  build-depends:       base               >= 4.7 && < 5
                     , containers         >= 0.6 && < 1
                     , random             >= 1.2 && < 2
                     , megaparsec         >= 9.0 && < 10
                     , parser-combinators >= 1.3 && < 2

executable ProbLang
  import:              warnings
  hs-source-dirs:      src
  main-is:             Main.hs
  other-modules:       AST
                     , Distributions
                     , Inference
                     , Interpreter
                     , Parser
  default-language:    Haskell2010
  build-depends:       base               >= 4.7 && < 5
                     , containers         >= 0.6 && < 1
                     , random             >= 1.2 && < 2
                     , megaparsec         >= 9.0 && < 10
                     , parser-combinators >= 1.3 && < 2

test-suite ProbLang-test
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  other-modules:       DistributionsSpec
                     , InterpreterSpec
                     , InferenceSpec
                     , ParserSpec
  default-language:    Haskell2010
  build-depends:       base        >= 4.7 && < 5
                     , containers  >= 0.6 && < 1
                     , ProbLang
                     , hspec       >= 2.7 && < 3
                     , QuickCheck  >= 2.14 && < 3
                     , megaparsec  >= 9.0 && < 10

source-repository head
  type:     git
  location: https://github.com/githubuser/ProbLang
